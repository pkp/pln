{
    "name": "pkp/pln",
    "description": "A plugin to enable OJS to preserve content in the PKP Preservation Network",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.2",
        "whikloj/bagittools": "^6.0"
    },
    "config": {
        "platform-check": true,
        "platform": {
            "php": "8.2.0"
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "prepend-autoloader": false,
        "sort-packages": true
    }
}

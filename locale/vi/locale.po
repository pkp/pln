msgstr "Đang lấy tài liệu dịch vụ."

msgid "plugins.generic.pln.notifications.pln_not_accepting"
msgstr "PKP PN hiện không tiếp nhận gói lưu chiểu."

msgid "plugins.generic.pln.notifications.pln_accepting"
msgstr "PKP PN đang tiếp nhận gói lưu chiểu."

msgid "plugins.generic.pln.notifications.check_status"
msgstr "Kiểm tra trạng thái các gói lưu chiểu."

msgid "plugins.generic.pln.notifications.issn_missing"
msgstr "Tạp chí phải có ISSN để gửi nội dung vào PKP PN."

msgid "plugins.generic.pln.notifications.http_error"
msgstr "Đã xảy ra lỗi khi kết nối với PKP PN. Vui lòng liên hệ quản trị viên hệ thống."

msgid "plugins.generic.pln.notifications.terms_updated"
msgstr "Điều khoản sử dụng PKP PN đã được cập nhật. Bạn phải đồng ý với điều khoản mới để tiếp tục gửi lưu chiểu."

msgid "plugins.generic.pln.notifications.zip_missing"
msgstr "Phải bật hỗ trợ ZipArchive để tiếp tục."

msgid "plugins.generic.pln.notifications.issn_setting"
msgstr "Tạp chí phải có ISSN trước khi bạn có thể đồng ý với điều khoản dịch vụ. Bạn có thể nhập ISSN tại trang Cài đặt tạp chí. Sau khi nhập ISSN, các điều khoản dịch vụ sẽ hiển thị bên dưới."

msgid "plugins.generic.pln.error.network.servicedocument"
msgstr "Lỗi mạng {$error} khi kết nối với PKP PN để lấy tài liệu dịch vụ."

msgid "plugins.generic.pln.error.network.deposit"
msgstr "Lỗi mạng {$error} khi kết nối với PKP PN để gửi gói lưu chiểu."

msgid "plugins.generic.pln.error.network.swordstatement"
msgstr "Lỗi mạng {$error} khi kết nối với PKP PN để lấy trạng thái mới của gói lưu chiểu."

msgid "plugins.generic.pln.error.http.servicedocument"
msgstr "Máy chủ PN trả về lỗi HTTP {$error} khi lấy tài liệu dịch vụ.\n{$message}"

msgid "plugins.generic.pln.error.http.deposit"
msgstr "Máy chủ PN trả về lỗi HTTP {$error} khi gửi gói lưu chiểu.\n{$message}"

msgid "plugins.generic.pln.error.http.swordstatement"
msgstr "Máy chủ PN trả về lỗi HTTP {$error} khi kiểm tra trạng thái gói lưu chiểu.\n{$message}"

msgid "plugins.generic.pln.error.depositor.missingpackage"
msgstr "Không tìm thấy tệp gói lưu chiểu {$file}."

msgid "plugins.generic.pln.error.depositor.export.articles.error"
msgstr "Đã xảy ra lỗi khi xuất các bài báo. Nhật ký lỗi máy chủ có thể chứa thêm thông tin."

msgid "plugins.generic.pln.error.depositor.export.issue.error"
msgstr "Đã xảy ra lỗi khi xuất số tạp chí. Nhật ký lỗi máy chủ có thể chứa thêm thông tin."

msgid "plugins.generic.pln.error.handler.uuid.invalid"
msgstr "UUID được yêu cầu không hợp lệ hoặc không đúng định dạng."

msgid "plugins.generic.pln.error.handler.uuid.notfound"
msgstr "Không có gói lưu chiểu nào mang UUID được yêu cầu."

msgid "plugins.generic.pln.error.handler.file.notfound"
msgstr "Không tìm thấy tệp gói lưu chiểu. Gói có thể chưa được đóng gói hoặc tệp đã bị xóa."

msgid "plugins.generic.pln.depositor.statusupdates"
msgstr "Đang xử lý cập nhật trạng thái các gói lưu chiểu."

msgid "plugins.generic.pln.depositor.updatedcontent"
msgstr "Đang xử lý nội dung đã cập nhật."

msgid "plugins.generic.pln.depositor.newcontent"
msgstr "Đang xử lý nội dung mới."

msgid "plugins.generic.pln.depositor.packagingdeposits"
msgstr "Đang đóng gói nội dung để lưu chiểu."

msgid "plugins.generic.pln.depositor.transferringdeposits"
msgstr "Đang gửi các gói lưu chiểu đến PKP PN."

msgid "plugins.generic.pln.depositor.statusupdates.processing"
msgstr "Đang cập nhật trạng thái cho {$depositId} ({$objectType}: {$objectId}) (Cục bộ: [{$statusLocal}], Xử lý: [{$statusProcessing}], LOCKSS: [{$statusLockss}])"

msgid "plugins.generic.pln.depositor.statusupdates.processing.processingState"
msgstr "Đã nhận trạng thái xử lý cho {$depositId} -> ({$processingState})"

msgid "plugins.generic.pln.depositor.packagingdeposits.processing"
msgstr "Đang đóng gói gói lưu chiểu {$depositId} ({$objectType}: {$objectId}) (Cục bộ: [{$statusLocal}], Xử lý: [{$statusProcessing}], LOCKSS: [{$statusLockss}])"

msgid "plugins.generic.pln.depositor.packagingdeposits.processing.error"
msgstr "Plugin Nhập/Xuất Native thất bại khi đóng gói gói lưu chiểu {$depositId}"

msgid "plugins.generic.pln.depositor.packagingdeposits.processing.packageFailed"
msgstr "Đóng gói gói lưu chiểu {$depositId} thất bại"

msgid "plugins.generic.pln.depositor.packagingdeposits.processing.packageSucceeded"
msgstr "Đóng gói gói lưu chiểu {$depositId} thành công"

msgid "plugins.generic.pln.depositor.transferringdeposits.processing"
msgstr "Đang chuyển gói lưu chiểu {$depositId} ({$objectType}: {$objectId}) (Cục bộ: [{$statusLocal}], Xử lý: [{$statusProcessing}], LOCKSS: [{$statusLockss}])"

msgid "plugins.generic.pln.depositor.transferringdeposits.processing.postAtom"
msgstr "Đang gửi tệp Atom đến máy chủ trung gian cho gói lưu chiểu {$depositId} (Cục bộ: [{$statusLocal}], Xử lý: [{$statusProcessing}], LOCKSS: [{$statusLockss}]) - (URL: [{$url}], đường dẫn Atom: [{$atomPath}], phương thức: [{$method}])"

msgid "plugins.generic.pln.depositor.transferringdeposits.processing.resultSucceeded"
msgstr "Đã gửi thành công tệp Atom của gói lưu chiểu {$depositId} đến máy chủ trung gian"

msgid "plugins.generic.pln.depositor.transferringdeposits.processing.resultFailed"
msgstr "Gửi tệp Atom của gói lưu chiểu {$depositId} đến máy chủ trung gian thất bại (Lỗi: [{$error} - [{$result}]])"

msgid "plugins.generic.pln.depositor.pruningDeposits.error"
msgstr "Không thể xóa các gói lưu chiểu sau: {$depositIds}."

msgid "plugins.generic.plngateway.displayName"
msgstr "Cổng PN"

msgid "plugins.generic.plngateway.description"
msgstr "Cung cấp trạng thái PKP PN và tiêu đề các bài báo gần đây cho máy chủ trung gian."

msgid "plugins.generic.pln.displayedstatus.pending"
msgstr "Đang chờ"

msgid "plugins.generic.pln.displayedstatus.pending.description"
msgstr "Quá trình lưu chiểu chưa bắt đầu"

msgid "plugins.generic.pln.displayedstatus.inprogress"
msgstr "Đang xử lý"

msgid "plugins.generic.pln.displayedstatus.inprogress.description"
msgstr "Quá trình lưu chiểu đang được thực hiện"

msgid "plugins.generic.pln.displayedstatus.completed"
msgstr "Hoàn thành"

msgid "plugins.generic.pln.displayedstatus.completed.description"
msgstr "Quá trình lưu chiểu đã hoàn thành"

msgid "plugins.generic.pln.displayedstatus.error"
msgstr "Lỗi"

msgid "plugins.generic.pln.displayedstatus.error.description"
msgstr "Đã xảy ra lỗi trong quá trình lưu chiểu"

msgid "plugins.generic.pln.status.warning"
msgstr "Có thể mất vài ngày để một gói lưu chiểu được xử lý hoàn toàn."

msgid "plugins.generic.pln.status.latestupdate"
msgstr "Cập nhật gần nhất"

msgid "plugins.generic.pln.status.description.title"
msgstr "Mô tả trạng thái"

msgid "plugins.generic.pln.status.error.harvest-error"
msgstr "Không thể tải gói lưu chiểu từ hệ thống của bạn. Hệ thống sẽ thử lại; trong thời gian chờ, hãy kiểm tra xem máy chủ có bị tường lửa chặn hay không."

msgid "plugins.generic.pln.status.error.deposit-error"
msgstr "Lưu chiểu thất bại. Hãy đảm bảo gói không vượt quá kích thước tối đa mà Mạng lưới Bảo tồn hỗ trợ."

msgid "plugins.generic.pln.status.error.reserialize-error"
msgstr "Đóng gói lại gói lưu chiểu thất bại; hệ thống sẽ thử lại."

msgid "plugins.generic.pln.status.error.virus-error"
msgstr "Gói lưu chiểu không vượt qua kiểm tra chống vi-rút. Bạn nên kiểm tra các tệp rồi gửi lại."

msgid "plugins.generic.pln.status.error.xml-error"
msgstr "Gói lưu chiểu không vượt qua bước xác thực nội dung XML. Hãy kiểm tra metadata của số/bài báo rồi gửi lại."

msgid "plugins.generic.pln.status.error.payload-error"
msgstr "Gói lưu chiểu không vượt qua bước xác thực payload. Bạn có thể thử gửi lại gói."

msgid "plugins.generic.pln.status.error.bag-error"
msgstr "Gói lưu chiểu không vượt qua bước xác thực BagIt. Bạn có thể thử gửi lại gói."

msgid "plugins.generic.pln.status.error.status-error"
msgstr "Gói đang được bảo tồn nhưng không thể kiểm tra trạng thái; hệ thống sẽ thử lại."

msgid "plugins.generic.pln.status.error.hold"
msgstr "Gói lưu chiểu đang bị tạm giữ vì phiên bản hệ thống của bạn cao hơn phiên bản mà mạng lưới hỗ trợ."

msgid "plugins.generic.pln"
msgstr "Plugin PKP PN"

msgid "plugins.generic.pln.description"
msgstr "Plugin PKP PN sẽ gửi nội dung đã xuất bản của tạp chí vào Mạng lưới Bảo tồn PKP."

msgid "plugins.generic.pln.onPluginEnabledNotification"
msgstr "Truy cập phần cài đặt plugin PKP PN để xem và chấp nhận các điều khoản dịch vụ."

msgid "plugins.generic.pln.manager.setup.description"
msgstr "<strong>Mạng lưới Bảo tồn PKP</strong><br /><br />Vui lòng đọc <a href=\"https://pkp.sfu.ca/pkp-pn\" target=\"_blank\">tổng quan về PKP PN</a> và hoàn thành <a href=\"{$plnPluginURL}\">biểu mẫu đơn giản này</a>. Tùy chọn này cho phép đưa tạp chí của bạn vào Mạng lưới Bảo tồn của Public Knowledge Project (PKP PN)."

msgid "plugins.generic.pln.settings"
msgstr "Cài đặt"

msgid "plugins.generic.pln.settings.acron_required"
msgstr "Plugin PKP PN yêu cầu plugin Acron hoặc một công cụ lập lịch định kỳ như \"cron\"."

msgid "plugins.generic.pln.settings.saved"
msgstr "Đã lưu cài đặt PKP PN."

msgid "plugins.generic.pln.settings.terms_of_use"
msgstr "Điều khoản sử dụng"

msgid "plugins.generic.pln.settings.terms_of_use_help"
msgstr "Với tư cách Quản lý tạp chí, tôi thiện chí chấp nhận và xác nhận các điều khoản và điều kiện sau để tham gia Mạng lưới Bảo tồn của Public Knowledge Project (PKP PN):"

msgid "plugins.generic.pln.settings.terms_of_use_agree"
msgstr "Tôi đồng ý"

msgid "plugins.generic.pln.settings.journal_uuid"
msgstr "Mã định danh tạp chí"

msgid "plugins.generic.pln.settings.journal_uuid_help"
msgstr "Đây là mã định danh duy nhất của tạp chí trong PKP PN. Bạn có thể cần cung cấp mã này cho quản trị viên PKP PN khi yêu cầu hỗ trợ."

msgid "plugins.generic.pln.settings.refresh"
msgstr "Làm mới"

msgid "plugins.generic.pln.settings.refresh_help"
msgstr "Nếu không có điều khoản nào được liệt kê ở trên hoặc bạn biết các điều khoản đã được cập nhật, hãy nhấn Làm mới để cập nhật danh sách."

msgid "plugins.generic.pln.required.object_type"
msgstr "Vui lòng chọn loại đối tượng lưu chiểu."

msgid "plugins.generic.pln.required.object_threshold"
msgstr "Vui lòng chọn ngưỡng số đối tượng cho mỗi gói lưu chiểu."

msgid "plugins.generic.pln.required.terms_of_use_agreement"
msgstr "Bạn phải đồng ý với điều khoản sử dụng của mạng lưới trước khi gửi nội dung vào PKP PN."

